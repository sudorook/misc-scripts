set -eu

ROOT="$(dirname "${0}")"

source "${ROOT}"/globals

function doas_user_or_root() {
  local cmd
  cmd=("${@}")
  if [ "${EUID}" -eq 0 ]; then
    eval "${cmd[*]}"
  else
    sudo bash -c "${cmd[*]}"
  fi
}

function do_drop_caches() {
  if [ -e /proc/sys/vm/drop_caches ]; then
    doas_user_or_root "echo 3 > drop_caches"
  elif check_command purge && [[ "${OSTYPE}" =~ darwin ]]; then
    doas_user_or_root "purge"
  else
    show_error "ERROR: ${OSTYPE@Q} not suported. Exiting."
    exit 3
  fi
}

sync
do_drop_caches
show_success "Done!"
