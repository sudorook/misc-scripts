set -euo pipefail

ROOT="$(dirname "$(readlink -f "${0}")")"

source "${ROOT}"/globals

! check_command qemu-img file stat && exit 3

#
# Functions
#

function abort() {
  if [ -f "${1}.bak" ]; then
    "${ESCALATE[@]}" mv -f "${1}.bak" "${1}"
  fi
}

function in_group() {
  local group
  for group in $(id -nG); do
    if [[ "${group}" == "${1}" ]]; then
      return 0
    fi
  done
  return 1
}

function user_logged_in() {
  local user
  for user in $(users); do
    if [[ "${user}" == "${1}" ]]; then
      return 0
    fi
  done
  return 1
}

function do_shrink() {
  if ! "${ESCALATE[@]}" test -r "${1}"; then
    show_error "ERROR: Cannot read ${1@Q}. Exiting."
    exit 3
  fi
  if ! [[ "$("${ESCALATE[@]}" file -b "${1}")" =~ QCOW ]]; then
    show_error "ERROR: ${1@Q} is not a QCOW2 file. Exiting."
    exit 3
  fi
  if "${ESCALATE[@]}" test -e "${1}.bak"; then
    show_error "ERROR: ${1@Q}.bak exists. Refusing to overwrite. Exiting."
    exit 3
  fi

  show_info "Shrinking..."
  trap "abort ${1@Q}" INT TERM ERR
  "${ESCALATE[@]}" mv -f "${1}" "${1}.bak"
  "${ESCALATE[@]}" qemu-img convert -O qcow2 "${1}.bak" "${1}"
  "${ESCALATE[@]}" chmod --reference="${1}.bak" "${1}"
  "${ESCALATE[@]}" chown --reference="${1}.bak" "${1}"
  trap - INT TERM ERR
  "${ESCALATE[@]}" rm -f "${1}.bak"
}

#
# Globals
#

if [[ $# -ne 1 ]]; then
  show_error "Usage: $(basename "${0}") <image.qcow2>"
  exit 3
fi

QCOW2="$(readlink -f "${1}")"
CURRENT_USER="$(id -un)"

# Check inputs and requirements.
if ! [ -f "${QCOW2}" ]; then
  show_error "ERROR: ${QCOW2@Q} doesn't exist. Exiting."
  exit 3
fi

OWNER="$(stat "${QCOW2}" -c "%U")"
GROUP="$(stat "${QCOW2}" -c "%G")"
DIRNAME="$(dirname "${QCOW2}")"

#
# Main
#

case "${OWNER}:${GROUP}" in
  nobody:* | *:kvm)
    show_error "ERROR: Cannot edit running instance. Exiting."
    exit 3
    ;;
esac

if [ "$(id -u)" -eq 0 ]; then
  # Already root: no further escalation possible or needed.
  ESCALATE=()
elif [[ "${OWNER}" == "${CURRENT_USER}" ]] &&
     [ -r "${QCOW2}" ] &&
     [ -w "${DIRNAME}" ] &&
     [ -x "${DIRNAME}" ] &&
     in_group "${GROUP}"; then
  # Everything the operation needs is already available: no escalation.
  ESCALATE=()
else
  case "${OWNER}" in
    root | qemu | libvirt-qemu)
      # System VM images: only root can touch them at all.
      show_info "${QCOW2@Q} owned by ${OWNER@Q}. Escalating with sudo..."
      ESCALATE=(sudo)
      ;;
    "${CURRENT_USER}")
      # Own the image but lack directory write or group rights, both of
      # which only root can supply.
      show_info "${QCOW2@Q} not manageable by ${CURRENT_USER@Q}. Escalating with sudo..."
      ESCALATE=(sudo)
      ;;
    *)
      if user_logged_in "${OWNER}"; then
        # Another user's image: run as that user only, never as root.
        show_warning "${QCOW2@Q} owned by ${OWNER}. Escalating with sudo -u ${OWNER@Q}..."
        ESCALATE=(sudo -u "${OWNER}")
      else
        show_error "User ${OWNER@Q} not recognized. Exiting."
        exit 3
      fi
      ;;
  esac
  # Authenticate once up front so the shrink runs uninterrupted.
  "${ESCALATE[@]}" -v
fi

OLD_SIZE="$("${ESCALATE[@]}" du -h "${QCOW2}" 2> /dev/null | cut -f1 || echo "?")"

do_shrink "${QCOW2}"

NEW_SIZE="$("${ESCALATE[@]}" du -h "${QCOW2}" 2> /dev/null | cut -f1 || echo "?")"

show_success "Compressed ${QCOW2@Q} from ${OLD_SIZE} to ${NEW_SIZE}."
sync
